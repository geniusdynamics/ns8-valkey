#
# ExecStartPre of valkey.service and valkey-replica.service: render
# state/valkey-<process>/ (valkey.conf, ACL of the module users, TLS files
# of the cluster bus, start script). Usage: valkey-prepare main|replica
#

import sys
import valkey_ns8 as vk

proc = sys.argv[1] if len(sys.argv) > 1 else "main"
if proc not in vk.PROCS:
    print(f"Unknown process {proc}", file=sys.stderr)
    sys.exit(2)
if not vk.role():
    print("The module is not configured yet", file=sys.stderr)
    sys.exit(1)
if proc == "replica" and not vk.is_cluster():
    print("The replica process runs in cluster mode only", file=sys.stderr)
    sys.exit(1)
if not vk.ports()[proc][0]:
    print(f"No TCP port for the {proc} process", file=sys.stderr)
    sys.exit(1)
vk.render(proc)
