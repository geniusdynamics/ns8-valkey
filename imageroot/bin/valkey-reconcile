#
# Repair the Valkey cluster topology from this member: meet new members,
# forget removed ones, spread the slots and place the replicas. Prints the
# list of changes as JSON. Usage: valkey-reconcile [reason]
#

import json
import sys
import valkey_ns8 as vk

reason = sys.argv[1] if len(sys.argv) > 1 else "manual"
changes = vk.reconcile_local(reason)
if changes:
    vk.fire_cluster_changed("reconciled")
json.dump({"changes": changes}, fp=sys.stdout)
