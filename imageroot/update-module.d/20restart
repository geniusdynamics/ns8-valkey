#
# Rolling restart after an update. In a cluster one member restarts at a
# time (a lock key in Valkey): its primaries first hand their slots to
# their replicas on other members (graceful failover, no data loss), then
# it restarts and waits until its replicas are in sync again. The
# coordinator moves the primaries back afterwards.
#

import sys
import agent
import valkey_ns8 as vk

if not vk.role():
    sys.exit(0)

units = ["valkey.service"] + (["valkey-replica.service"] if vk.is_cluster() else [])
if not vk.is_cluster():
    agent.run_helper("systemctl", "--user", "try-restart", *units)
    sys.exit(0)

# Periodic topology check (added in a later release than some installs).
# It skips its run while any member holds the restart lock below, so it
# never moves slots in the middle of the rolling restart.
agent.run_helper("systemctl", "--user", "enable", "--now", "valkey-reconcile.timer")

module_id = vk.env("MODULE_ID")
member_list = vk.members()
client = vk.cluster_client(member_list)
if not vk.acquire_restart_lock(client, module_id):
    vk.warning("Another member is still restarting: restarting anyway")
try:
    vk.handover(member_list, module_id)
    agent.run_helper("systemctl", "--user", "try-restart", *units)
    for proc in vk.PROCS:
        vk.wait_ready(proc, timeout=300)
        if not vk.wait_replication(proc):
            vk.warning(f"The {proc} process is not in sync yet")
finally:
    vk.release_restart_lock(client, module_id)
