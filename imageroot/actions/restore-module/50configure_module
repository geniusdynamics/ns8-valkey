import json
import os
import sys
import agent
import agent.tasks

request = json.load(sys.stdin)
renv = request.get("environment", {})
maxmemory = renv.get("VALKEY_MAXMEMORY_MB", "0")
ret = agent.tasks.run(agent_id=os.environ["AGENT_ID"], action="configure-module", data={
    "role": "standalone",
    "maxmemory_mb": int(maxmemory) if str(maxmemory).isdigit() else 0,
})
agent.assert_exp(ret["exit_code"] == 0, "configure-module failed")
