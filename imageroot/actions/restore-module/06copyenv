#
# A restored instance always comes back standalone: the backup of a
# cluster member holds its share of the keyspace and the client users.
# Join a cluster again from Settings if needed.
#

import json
import sys
import agent

request = json.load(sys.stdin)
renv = request.get("environment", {})
agent.mset_env({
    "VALKEY_MAXMEMORY_MB": renv.get("VALKEY_MAXMEMORY_MB", "0"),
    "VALKEY_ROLE": "",
    "VALKEY_CLUSTER_ID": "",
    "VALKEY_RESET_CLUSTER": "1",
})
