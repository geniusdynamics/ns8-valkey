#
# Delete the Valkey ACL user of a client on every reachable process
# (role valkeyclient). Also run by the module-removed event handler.
#

import json
import sys
import agent
import valkey_ns8 as vk

data = json.load(sys.stdin)
if not vk.role():
    vk.validation_error("", "", "not_configured")
client_id = vk.resolve_client_id(data)
username = vk.client_username(client_id)
deleted = []


def deluser(conn):
    deleted.append(int(conn.execute_command("ACL", "DELUSER", username)))
    vk.save_acl(conn)


ok, failed = vk.for_each_process(deluser)
if not ok:
    print(agent.SD_ERR + f"Cannot delete the Valkey user {username}: no process answered", file=sys.stderr)
    sys.exit(1)
if failed:
    print(agent.SD_WARNING + f"User {username} not deleted on {', '.join(failed)}: "
          "removed when they start", file=sys.stderr)
json.dump({"client_id": client_id, "revoked": any(deleted)}, fp=sys.stdout)
