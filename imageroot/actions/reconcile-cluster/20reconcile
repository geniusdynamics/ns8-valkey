import json
import sys
import valkey_ns8 as vk

data = json.load(sys.stdin)
if not vk.is_cluster():
    json.dump({"changes": []}, fp=sys.stdout)
    sys.exit(0)
changes = vk.reconcile_local(data.get("reason") or "requested")
vk.publish_records()
vk.fire_cluster_changed("reconciled")
json.dump({"changes": changes}, fp=sys.stdout)
