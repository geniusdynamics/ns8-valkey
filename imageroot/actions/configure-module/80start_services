#
# Start the Valkey processes. A process restarts only when its rendered
# configuration changed, so saving the same settings does not interrupt a
# cluster member. The environment written by the previous steps is
# reloaded here: actions see it only in os.environ of later steps.
#

import os
import sys
import agent
import valkey_ns8 as vk

os.environ.update(agent.read_envfile("environment"))

units = ["valkey.service"]
if vk.is_cluster():
    units.append("valkey-replica.service")
else:
    agent.run_helper("systemctl", "--user", "disable", "--now", "valkey-replica.service",
                     "valkey-reconcile.timer")

reset = any(vk.env(var) == "1" for var in ("VALKEY_RESET_CLUSTER", "VALKEY_RESET_DATA", "VALKEY_RESET_REPLICA"))
for unit in units:
    proc = "main" if unit == "valkey.service" else "replica"
    changed = vk.render_changed(proc)
    active = agent.run_helper("systemctl", "--user", "-q", "is-active", unit).returncode == 0
    agent.run_helper("systemctl", "--user", "enable", unit).check_returncode()
    if changed or reset or not active:
        agent.run_helper("systemctl", "--user", "restart", unit).check_returncode()

# The reset markers were consumed by the processes started above: a later
# restart must keep the data and the cluster identity
agent.munset_env(["VALKEY_RESET_CLUSTER", "VALKEY_RESET_DATA", "VALKEY_RESET_REPLICA"])
for proc in vk.PROCS:
    for marker in ("reset-cluster", "reset-data"):
        path = vk.state_path(f"valkey-{proc}", marker)
        if os.path.exists(path):
            os.unlink(path)

# Periodic topology check, cluster mode only
if vk.is_cluster():
    agent.run_helper("systemctl", "--user", "enable", "--now", "valkey-reconcile.timer").check_returncode()

# The consistency mode applies at runtime too (CONFIG SET), so a change
# needs no restart
for proc in (vk.PROCS if vk.is_cluster() else ()):
    vk.apply_consistency_runtime(vk.consistency(), [f"127.0.0.1:{vk.ports()[proc][0]}"])
