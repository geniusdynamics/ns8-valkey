#
# Allowed role changes:
#   (none) or standalone -> any role
#   initial -> standalone   only when no other member is left
#   join -> standalone      the member leaves the cluster (its slots are
#                           handed over) and starts empty
#   initial <-> join, or another cluster: go standalone first
#

import json
import os
import sys
import agent
import valkey_ns8 as vk

agent.set_weight(os.path.basename(__file__), 0)

data = json.load(sys.stdin)
new_role = data["role"]
current = vk.role()
cid = (data.get("cluster_id") or "").strip()

if new_role == "join":
    if not cid:
        vk.validation_error("cluster_id", cid, "required")
    if current == "join" and cid != vk.env("VALKEY_CLUSTER_ID"):
        vk.validation_error("cluster_id", cid, "leave_cluster_first")
    if current == "initial":
        vk.validation_error("role", new_role, "leave_cluster_first")
    if current != "join":
        candidates = {c["cluster_id"]: c for c in vk.cluster_candidates()}
        if cid not in candidates:
            vk.validation_error("cluster_id", cid, "cluster_not_found")
        records = vk.cluster_records(wanted=cid)
        same_node = [mid for mid, rec in records.items() if str(rec.get("node")) == vk.env("NODE_ID")]
        allow = any(rec.get("allow_same_node") == "true" for rec in records.values())
        if same_node and not allow:
            vk.validation_error("cluster_id", cid, "node_already_member")
        # A standalone instance with data cannot join: the data would be lost
        if current == "standalone":
            try:
                if vk.local_conn("main").dbsize() > 0:
                    vk.validation_error("role", new_role, "instance_not_empty")
            except SystemExit:
                raise
            except Exception:
                pass
elif new_role == "initial":
    if current == "join":
        vk.validation_error("role", new_role, "leave_cluster_first")
elif new_role == "standalone" and current == "initial":
    others = [m for m in vk.members() if m["module_id"] != vk.env("MODULE_ID")]
    if others:
        vk.validation_error("role", new_role, "cluster_has_members")
