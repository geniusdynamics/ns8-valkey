#
# Apply the role. Joining asks a member of the cluster for the cluster
# secrets with the guarded admit-member action (role valkeypeer): the admin
# and replication passwords and the CA of the cluster bus go to 0600 files,
# never to the environment or the logs.
#

import json
import os
import sys
import agent
import agent.tasks
import valkey_ns8 as vk

data = json.load(sys.stdin)
new_role = data["role"]
current = vk.role()
module_id = vk.env("MODULE_ID")
envmap = {"VALKEY_MAXMEMORY_MB": str(data.get("maxmemory_mb", int(vk.env("VALKEY_MAXMEMORY_MB", "0") or 0)))}

if new_role == "join" and current != "join":
    cid = data["cluster_id"].strip()
    member_list = vk.members(wanted=cid)
    admitted = None
    for target in [m["module_id"] for m in member_list]:
        ret = agent.tasks.run(agent_id=f"module/{target}", action="admit-member",
                              data={"module_id": module_id, "node_id": vk.env("NODE_ID")},
                              extra={"isNotificationHidden": True})
        if ret["exit_code"] == 0:
            admitted = ret["output"]
            break
        print(agent.SD_WARNING + f"admit-member on {target} failed (exit code {ret['exit_code']})", file=sys.stderr)
    if not admitted:
        print(agent.SD_ERR + f"No member of {cid} admitted this instance", file=sys.stderr)
        sys.exit(1)
    values = vk.read_secrets()
    values["VALKEY_ADMIN_PASSWORD"] = admitted["admin_password"]
    values["VALKEY_REPL_PASSWORD"] = admitted["repl_password"]
    vk.write_secrets(values)
    vk.store_ca(admitted["ca_cert"], admitted["ca_key"])
    envmap.update({"VALKEY_ROLE": "join", "VALKEY_CLUSTER_ID": cid, "VALKEY_RESET_CLUSTER": "1",
                   "VALKEY_RESET_DATA": "1", "VALKEY_RESET_REPLICA": "1",
                   "VALKEY_ALLOW_SAME_NODE": "1" if admitted.get("allow_same_node") else "0"})
elif new_role == "initial" and current != "initial":
    vk.ensure_secrets()
    vk.ensure_ca()
    # A new cluster identity; the data of a standalone server is kept
    envmap.update({"VALKEY_ROLE": "initial", "VALKEY_CLUSTER_ID": module_id, "VALKEY_RESET_CLUSTER": "1",
                   "VALKEY_RESET_REPLICA": "1",
                   "VALKEY_ALLOW_SAME_NODE": "1" if data.get("allow_same_node") else "0"})
elif new_role == "standalone" and current in vk.CLUSTER_ROLES:
    member_list = vk.members()
    others = [m for m in member_list if m["module_id"] != module_id]
    if current == "join" and others:
        if not vk.leave_cluster(member_list, module_id):
            print(agent.SD_ERR + "Cannot hand the slots of this member over: not leaving", file=sys.stderr)
            sys.exit(1)
        # The data belonged to the cluster: start empty
        envmap["VALKEY_RESET_DATA"] = "1"
    envmap.update({"VALKEY_ROLE": "standalone", "VALKEY_CLUSTER_ID": "", "VALKEY_RESET_CLUSTER": "1"})
    # Stop being discovered as a member before the restart
    agent.redis_connect(privileged=True).delete(f"module/{module_id}/srv/tcp/{vk.CLUSTER_SERVICE}")
    with open(".left-cluster", "w") as fp:
        json.dump({m["module_id"]: m for m in others}, fp)
elif new_role == "standalone":
    vk.ensure_secrets()
    envmap.update({"VALKEY_ROLE": "standalone", "VALKEY_CLUSTER_ID": ""})

agent.mset_env(envmap)
